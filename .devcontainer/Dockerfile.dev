FROM mcr.microsoft.com/devcontainers/rust:1-bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    lld clang cmake pkg-config libssl-dev build-essential \
    python3 python3-pip python3-venv git-lfs sqlite3 libsqlite3-dev jq curl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && git lfs install

USER vscode
ENV PATH="/home/vscode/.local/bin:/usr/local/cargo/bin:${PATH}"

RUN rustup default stable \
 && rustup component add rustfmt clippy rust-src \
 && rustup target add wasm32-unknown-unknown

# Install uv for Python management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && uv python install 3.12

# Install cargo-binstall for fast tool installation
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh | bash

# Standard Org-wide Tooling
RUN cargo binstall --no-confirm \
    cargo-watch cargo-nextest cargo-deny cargo-edit cargo-expand wasm-pack
