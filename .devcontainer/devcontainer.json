{
  "name": "RuralPeds Hardened Rust Dev",
  "build": {
    "dockerfile": "Dockerfile.dev",
    "context": ".."
  },
  "runArgs": [
    "--init"
  ],
  "remoteUser": "vscode",
  // HARDENED: The workspace is stored in a named volume, not a host bind-mount.
  // This prevents the container/agent from ever touching your host OS files.
  "workspaceFolder": "/workspaces/agent-based-modeling",
  "workspaceMount": "source=agent-based-modeling-workspace,target=/workspaces/agent-based-modeling,type=volume",
  "mounts": [
    // Persist cargo registry for faster builds across different projects
    "source=ruralpeds-cargo-registry,target=/usr/local/cargo/registry,type=bind,consistency=cached",
    // Project-specific build artifacts volume
    "source=agent-based-modeling-target,target=/workspaces/agent-based-modeling/target,type=volume"
  ],
  "containerEnv": {
    "CARGO_HOME": "/usr/local/cargo",
    "RUSTUP_HOME": "/usr/local/rustup",
    "RUST_BACKTRACE": "1",
    "RUST_LOG": "info"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:20": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates",
        "fill-labs.dependi",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "usernamehw.errorlens"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.check.allTargets": true,
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
